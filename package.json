{
  "name": "gradual",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pi Agent Demo Platform — Hono + Postgres + Electric + Better Auth",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "better-auth": "^1.1.10",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.2",
    "gpt-tokenizer": "^2.8.1",
    "hono": "^4.6.16",
    "nanoid": "^5.0.9",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
