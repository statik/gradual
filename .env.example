# Server
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# Postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/gradual

# Better Auth
BETTER_AUTH_SECRET=replace-me-with-32-bytes-of-randomness
BETTER_AUTH_URL=http://localhost:3000

# OAuth providers (leave empty to disable a provider)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Electric sync
ELECTRIC_URL=http://localhost:3001
ELECTRIC_SOURCE_ID=
ELECTRIC_SOURCE_SECRET=

# Provider API keys (server-side only — never exposed to browser)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Quota defaults (tokens per window)
QUOTA_ANON_TOKENS_PER_DAY=20000
QUOTA_FREE_TOKENS_PER_DAY=200000
